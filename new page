<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Modern Landing Page</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #0f172a;
      color: white;
      overflow-x: hidden;
    }

    header {
      width: 100%;
      padding: 20px 10%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(0,0,0,0.3);
      position: fixed;
      top: 0;
      left: 0;
      backdrop-filter: blur(10px);
      z-index: 1000;
    }

    .logo {
      font-size: 28px;
      font-weight: bold;
      color: #38bdf8;
    }

    nav a {
      text-decoration: none;
      color: white;
      margin-left: 25px;
      transition: 0.3s;
    }

    nav a:hover {
      color: #38bdf8;
    }

    .hero {
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 0 20px;
      background: linear-gradient(to right, #0f172a, #1e293b);
    }

    .hero-content h1 {
      font-size: 60px;
      margin-bottom: 20px;
    }

    .hero-content p {
      font-size: 20px;
      max-width: 700px;
      margin: auto;
      line-height: 1.6;
      color: #cbd5e1;
    }

    .hero-content button {
      margin-top: 30px;
      padding: 15px 35px;
      border: none;
      background: #38bdf8;
      color: white;
      font-size: 18px;
      border-radius: 8px;
      cursor: pointer;
      transition: 0.3s;
    }

    .hero-content button:hover {
      background: #0ea5e9;
      transform: scale(1.05);
    }

    .features {
      padding: 100px 10%;
      background: #111827;
      text-align: center;
    }

    .features h2 {
      font-size: 40px;
      margin-bottom: 50px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
    }

    .card {
      background: #1e293b;
      padding: 30px;
      border-radius: 15px;
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-10px);
      background: #334155;
    }

    .card h3 {
      margin-bottom: 15px;
      color: #38bdf8;
    }

    footer {
      padding: 30px;
      text-align: center;
      background: #0f172a;
      color: #94a3b8;
    }

    @media(max-width: 768px) {
      .hero-content h1 {
        font-size: 40px;
      }

      nav {
        display: none;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">MyBrand</div>

    <nav>
      <a href="#">Home</a>
      <a href="#">Features</a>
      <a href="#">About</a>
      <a href="#">Contact</a>
    </nav>
  </header>

  <section class="hero">
    <div class="hero-content">
      <h1>Build Something Amazing</h1>
      <p>
        Create modern websites easily and deploy them smoothly on GitHub and Vercel
        without any 404 errors.
      </p>

      <button>Get Started</button>
    </div>
  </section>

  <section class="features">
    <h2>Features</h2>

    <div class="cards">
      <div class="card">
        <h3>Responsive Design</h3>
        <p>Looks perfect on desktop, tablet, and mobile devices.</p>
      </div>

      <div class="card">
        <h3>Fast Loading</h3>
        <p>Optimized layout and lightweight code for speed.</p>
      </div>

      <div class="card">
        <h3>Easy Deployment</h3>
        <p>Deploy directly on GitHub and Vercel without issues.</p>
      </div>
    </div>
  </section>

  <footer>
    © 2026 MyBrand. All Rights Reserved.
  </footer>

</body>
</html>
